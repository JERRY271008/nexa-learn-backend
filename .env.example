# Copy this file to .env — the defaults below already match how this project
# is configured to run (a local Ollama model, no API key required).
#
# Ollama must be installed and running separately (https://ollama.com), with
# the model below pulled first, e.g.:
#   ollama pull llama3.2:3b
#   ollama serve

PORT=5001
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Comma-free single origin, or * for any origin (fine for local dev).
CORS_ORIGIN=*
